# ------------------------------------------------------------------
# Smoobu — LECTURE SEULE, côté serveur uniquement.
# Le site n'écrit jamais dans le channel manager : il l'affiche.
# Authentification HMAC (l'auth par simple Api-Key est dépréciée
# depuis fin septembre 2026).
# hPanel Smoobu → Paramètres → API
# ------------------------------------------------------------------
SMOOBU_API_KEY=
SMOOBU_API_SECRET=

# Identifiant de l'iframe du moteur de réservation.
# Smoobu → Configuration → Moteur de réservation → Intégrer sur le site.
# C'est le nombre à la fin de l'URL login.smoobu.com/fr/booking-tool/iframe/XXXXX
NEXT_PUBLIC_SMOOBU_IFRAME_ID=

# ------------------------------------------------------------------
# Formulaire de contact (Resend).
# Sans clé, le formulaire affiche le repli téléphone/email : il ne
# prétend jamais avoir envoyé un message qui n'est pas parti.
# ------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM=site@demeuredestroisfoudres.fr
CONTACT_TO=contact@demeuredestroisfoudres.fr

# ------------------------------------------------------------------
# Bascule de mise en ligne.
# Tant que ce n'est pas "1", le site est en noindex et robots.txt est
# fermé : l'URL .vercel.app ne peut pas se faire indexer et concurrencer
# le domaine du client. À poser à "1" une fois le domaine rattaché.
# ------------------------------------------------------------------
SITE_EN_LIGNE=
